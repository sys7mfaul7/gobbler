{
    "name": "sys7mfaul7/playlistgobbler",
    "description": "Nextcloud app for the gobbler playlist sync project",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Shawn Tolley"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nextcloud/ocp": "dev-stable31"
    },
    "autoload": {
        "psr-4": {
            "OCA\\PlaylistGobbler\\": "lib/"
        }
    },
    "scripts": {
        "lint": "find lib appinfo tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit -c tests/phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "OCP\\": "vendor/nextcloud/ocp/OCP",
            "NCU\\": "vendor/nextcloud/ocp/NCU",
            "OCA\\PlaylistGobbler\\Tests\\": "tests/"
        }
    }
}
